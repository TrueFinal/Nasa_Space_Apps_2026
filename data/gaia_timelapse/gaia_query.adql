
        SELECT source_id, ra, dec, ref_epoch, pmra, pmdec,
               phot_g_mean_mag, ruwe
        FROM gaiadr3.gaia_source
        WHERE 1=CONTAINS(POINT('ICRS', ra, dec),
                         CIRCLE('ICRS', 133.786245, -7.244372, 0.024444444444444446))
          AND phot_g_mean_mag < 20
    